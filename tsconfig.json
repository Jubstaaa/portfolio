{
    "extends": "@jubstaaa/config/tsconfig/next",
    "compilerOptions": {
        "types": ["node", "bun"],
        "jsx": "react-jsx",
        "paths": {
            "@/*": ["./src/*"],
            "#site/content": ["./.velite"]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts",
        "**/*.mts"
    ],
    "exclude": ["node_modules"]
}
