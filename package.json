{
    "name": "portfolio",
    "version": "0.1.0",
    "private": true,
    "packageManager": "bun@1.4.4",
    "engines": {
        "node": ">=24 <25"
    },
    "description": "Personal portfolio and blog.",
    "scripts": {
        "dev": "velite build && next dev",
        "build": "velite build && next build",
        "start": "next start",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "typecheck": "velite build && next typegen && tsc --noEmit",
        "test": "bun test",
        "test:smoke": "bun test ./e2e/site.smoke.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "audit": "bun audit --audit-level=high --ignore=GHSA-3jxr-9vmj-r5cp --ignore=GHSA-6j4f-fj2g-mc7p --ignore=GHSA-g3hv-75wg-m249 --ignore=GHSA-jxxr-4gwj-5jf2 --ignore=GHSA-mh99-v99m-4gvg --ignore=GHSA-q2hr-2g5m-vwhr --ignore=GHSA-qhr7-859c-m2p7 --ignore=GHSA-rgw5-rvv9-x895",
        "optimize:images": "bun scripts/optimize-images.mjs",
        "velite": "velite build",
        "velite:watch": "velite build --watch",
        "prepare": "husky"
    },
    "dependencies": {
        "@date-fns/utc": "^2.1.1",
        "@tanstack/react-query": "^5.108.0",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "feed": "^6.0.0",
        "lodash-es": "^4.18.1",
        "lucide-react": "^1.75.0",
        "next": "16.4.6",
        "next-themes": "^0.4.6",
        "p-retry": "^9.0.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "sharp": "^0.35.5",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@commitlint/types": "^21.2.3",
        "@mswjs/interceptors": "^0.45.12",
        "@tailwindcss/postcss": "^4.3.5",
        "@types/bun": "^1.4.4",
        "@types/hast": "^3.0.5",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^24",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "eslint": "^10.15.0",
        "eslint-config-next": "16.4.6",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-perfectionist": "^5.14.0",
        "hast-util-heading-rank": "^3.0.0",
        "hast-util-shift-heading": "^4.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.1",
        "msw": "^3.0.7",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "rehype-pretty-code": "^0.14.6",
        "remark-gfm": "^4.0.1",
        "schema-dts": "^2.1.0",
        "shiki": "^4.6.0",
        "tailwindcss": "^4.3.5",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.73.0",
        "unist-util-visit": "^5.2.0",
        "velite": "^0.4.0"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx,mjs,cjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,mdx,css,yml,yaml}": [
            "prettier --write"
        ]
    },
    "trustedDependencies": [
        "unrs-resolver"
    ],
    "overrides": {
        "@babel/core": "^7.29.13",
        "baseline-browser-mapping": "^2.11.38",
        "browserslist": "^4.29.6",
        "fast-uri": "^3.1.9",
        "js-yaml": "^4.3.2",
        "sharp": "^0.35.5",
        "source-map-js": "^1.2.2",
        "zod": "^4.6.7"
    }
}
